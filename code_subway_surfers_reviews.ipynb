   "source": [
    "# Convert ke DataFrame\n",
    "df = pd.DataFrame(result)\n",
    "\n",
    "# Ambil kolom penting aja\n",
    "df = df[['content', 'score']]\n",
    "df.columns = ['review', 'rating']\n",
    "\n",
    "# Filter English\n",
    "def is_english(text):\n",
    "    try:\n",
    "        return detect(text) == 'en'\n",
    "    except:\n",
    "        return False\n",
    "\n",
    "df = df[df['review'].apply(is_english)]\n",
    "\n",
    "# Reset index\n",
    "df = df.reset_index(drop=True)\n",
    "\n",
    "print(len(df))\n",
    "df.head()"
   ]
